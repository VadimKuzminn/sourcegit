<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:c="using:SourceGit.Converters"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
                    x:Class="SourceGit.Views.Hotkeys"
                    x:DataType="vm:HotkeyEditor"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.Hotkeys}"
                    Width="720" Height="640"
                    MinWidth="560" MinHeight="400"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Hotkeys}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.Hotkeys}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- Toolbar -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="16,12,16,4">
      <TextBox Grid.Column="0"
               x:Name="TxtFilter"
               Height="28"
               CornerRadius="4"
               Watermark="{DynamicResource Text.Hotkeys.Editor.Search}"
               Text="{Binding Filter, Mode=TwoWay}"
               VerticalContentAlignment="Center">
        <TextBox.InnerLeftContent>
          <Path Width="14" Height="14"
                Margin="6,0,0,0"
                Fill="{DynamicResource Brush.FG2}"
                Data="{StaticResource Icons.Search}"/>
        </TextBox.InnerLeftContent>

        <TextBox.InnerRightContent>
          <Button Classes="icon_button"
                  Width="16"
                  Margin="0,0,6,0"
                  Click="OnClearFilter"
                  IsVisible="{Binding Filter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Path Width="14" Height="14" Fill="{DynamicResource Brush.FG2}" Data="{StaticResource Icons.Clear}"/>
          </Button>
        </TextBox.InnerRightContent>
      </TextBox>

      <!-- Find by shortcut: press the button, then the key combination -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
        <Button Classes="filter_recorder"
                Classes.recording="{Binding IsRecordingFilter}"
                Classes.active="{Binding FilterGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                Height="28"
                Click="OnToggleRecordFilter"
                LostFocus="OnFilterRecorderLostFocus"
                ToolTip.Tip="{DynamicResource Text.Hotkeys.Editor.FindByShortcut}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Width="14" Height="14" VerticalAlignment="Center" Data="{StaticResource Icons.Hotkeys}"/>
            <TextBlock Classes="gesture" Text="{Binding FilterGestureText}" VerticalAlignment="Center"/>
            <TextBlock Classes="recording" Text="{DynamicResource Text.Hotkeys.Editor.PressKeys}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button Classes="icon_button"
                Width="24" Height="28"
                Click="OnClearFilterGesture"
                IsVisible="{Binding FilterGesture, Converter={x:Static ObjectConverters.IsNotNull}}"
                ToolTip.Tip="{DynamicResource Text.Hotkeys.Editor.ClearFindByShortcut}">
          <Path Width="11" Height="11" Data="{StaticResource Icons.Close}"/>
        </Button>
      </StackPanel>

      <Button Grid.Column="2"
              Classes="flat"
              Height="28"
              Margin="8,0,0,0"
              Padding="12,0"
              Content="{DynamicResource Text.Hotkeys.Editor.ResetAll}"
              IsEnabled="{Binding HasCustomized}"
              Click="OnResetAll"/>
    </Grid>

    <!-- Nothing matches the filters -->
    <TextBlock Grid.Row="2"
               Margin="16,32,16,0"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.FG2}"
               Text="{Binding EmptyMessage}"
               IsVisible="{Binding EmptyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- Commands -->
    <ScrollViewer Grid.Row="2" Margin="0,4,0,0" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Groups}" Margin="16,0,16,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:HotkeyEditorGroup">
            <StackPanel Orientation="Vertical" Margin="0,8,0,0">
              <TextBlock Text="{Binding Header}"
                         Foreground="{DynamicResource Brush.FG2}"
                         FontWeight="Bold"
                         FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=DefaultFontSize, Converter={x:Static c:DoubleConverters.Increase}}"
                         Margin="0,0,0,4"/>

              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:HotkeyEditorItem">
                    <Border Classes="hotkey_row" Height="30" CornerRadius="4" Background="Transparent">
                      <Grid ColumnDefinitions="*,190,28,28" Margin="8,0,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding Label}"/>
                          <Ellipse Width="6" Height="6"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource Brush.Accent}"
                                   IsVisible="{Binding IsCustomized}"
                                   ToolTip.Tip="{DynamicResource Text.Hotkeys.Editor.Customized}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="hotkey_recorder"
                                Classes.recording="{Binding IsRecording}"
                                Classes.empty="{Binding !HasGesture}"
                                Height="24"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="OnStartRecording"
                                LostFocus="OnRecorderLostFocus"
                                ToolTip.Tip="{DynamicResource Text.Hotkeys.Editor.ClickToChange}">
                          <Grid>
                            <TextBlock Classes="gesture" Text="{Binding GestureText}"/>
                            <TextBlock Classes="placeholder" Text="{DynamicResource Text.Hotkeys.Editor.None}"/>
                            <TextBlock Classes="recording" Text="{DynamicResource Text.Hotkeys.Editor.PressKeys}"/>
                          </Grid>
                        </Button>

                        <Button Grid.Column="2"
                                Classes="icon_button"
                                Width="24" Height="24"
                                Click="OnResetItem"
                                IsVisible="{Binding IsCustomized}"
                                ToolTip.Tip="{DynamicResource Text.Hotkeys.Editor.Reset}">
                          <Path Width="12" Height="12" Data="{StaticResource Icons.Undo}"/>
                        </Button>

                        <Button Grid.Column="3"
                                Classes="icon_button"
                                Width="24" Height="24"
                                Click="OnClearItem"
                                IsVisible="{Binding HasGesture}"
                                ToolTip.Tip="{DynamicResource Text.Hotkeys.Editor.Clear}">
                          <Path Width="11" Height="11" Data="{StaticResource Icons.Close}"/>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Status -->
    <Border Grid.Row="3"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Brush.Border0}"
            Background="{DynamicResource Brush.Window}"
            Padding="16,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0"
              Width="14" Height="14"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              Data="{StaticResource Icons.Info}"
              Fill="DarkOrange"
              IsVisible="{Binding IsMessageWarning}"/>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Margin="12,0,0,0"
                    Spacing="8"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsConfirmingReassign}">
          <Button Classes="flat primary"
                  Height="26"
                  Padding="12,0"
                  Content="{DynamicResource Text.Hotkeys.Editor.Reassign}"
                  Click="OnConfirmReassign"
                  ToolTip.Tip="Enter"/>
          <Button Classes="flat"
                  Height="26"
                  Padding="12,0"
                  Content="{DynamicResource Text.Hotkeys.Editor.Cancel}"
                  Click="OnCancelReassign"
                  ToolTip.Tip="Esc"/>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{Binding Message}"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Grid.Column="1"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{DynamicResource Text.Hotkeys.Editor.Tip}"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
      </Grid>
    </Border>
  </Grid>

  <v:ChromelessWindow.Styles>
    <Style Selector="Border.hotkey_row:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
    </Style>

    <Style Selector="Button.filter_recorder">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.filter_recorder.active, Button.filter_recorder.recording">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Button.filter_recorder TextBlock.gesture">
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="FontFamily" Value="{DynamicResource Fonts.Monospace}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.filter_recorder TextBlock.recording">
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Button.filter_recorder.active TextBlock.gesture">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.filter_recorder.recording TextBlock.gesture">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.filter_recorder.recording TextBlock.recording">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="Button.hotkey_recorder">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Contents}"/>
    </Style>
    <Style Selector="Button.hotkey_recorder.recording">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.hotkey_recorder TextBlock.gesture">
      <Setter Property="FontFamily" Value="{DynamicResource Fonts.Monospace}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.hotkey_recorder TextBlock.placeholder">
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
      <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    <Style Selector="Button.hotkey_recorder TextBlock.recording">
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Button.hotkey_recorder.empty TextBlock.gesture">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.hotkey_recorder.empty TextBlock.placeholder">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.hotkey_recorder.recording TextBlock.gesture, Button.hotkey_recorder.recording TextBlock.placeholder">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.hotkey_recorder.recording TextBlock.recording">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </v:ChromelessWindow.Styles>
</v:ChromelessWindow>
